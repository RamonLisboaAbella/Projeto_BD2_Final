
-- =====================================================
-- SISTEMA DE MANUTENÇÃO DE COMPUTADORES
-- MODELO FÍSICO - SQL SERVER
-- TOTAL: 17 TABELAS
-- =====================================================

-- 1. CLIENTE
CREATE TABLE cliente (
    id_cliente INT IDENTITY(1,1) PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    cpf CHAR(11) NOT NULL,
    email VARCHAR(100),
    telefone VARCHAR(15),
    dt_cadastro DATE NOT NULL DEFAULT CAST(GETDATE() AS DATE),

    CONSTRAINT ux_cliente_cpf UNIQUE (cpf)
);

-- 2. TIPO DE EQUIPAMENTO
CREATE TABLE tipo_equipamento (
    id_tipo_equipamento TINYINT IDENTITY(1,1) PRIMARY KEY,
    nome VARCHAR(30) NOT NULL,

    CONSTRAINT ux_tipo_equipamento_nome UNIQUE (nome)
);

-- 3. MARCA
CREATE TABLE marca (
    id_marca SMALLINT IDENTITY(1,1) PRIMARY KEY,
    nome VARCHAR(50) NOT NULL,

    CONSTRAINT ux_marca_nome UNIQUE (nome)
);

-- 4. EQUIPAMENTO
CREATE TABLE equipamento (
    id_equipamento INT IDENTITY(1,1) PRIMARY KEY,
    id_cliente INT NOT NULL,
    id_tipo_equipamento TINYINT NOT NULL,
    id_marca SMALLINT NOT NULL,
    modelo VARCHAR(60) NOT NULL,
    numero_serie VARCHAR(50),
    dt_cadastro DATE NOT NULL DEFAULT CAST(GETDATE() AS DATE),
    observacao VARCHAR(200),

    CONSTRAINT fk_equipamento_cliente
        FOREIGN KEY (id_cliente) REFERENCES cliente(id_cliente),

    CONSTRAINT fk_equipamento_tipo
        FOREIGN KEY (id_tipo_equipamento)
        REFERENCES tipo_equipamento(id_tipo_equipamento),

    CONSTRAINT fk_equipamento_marca
        FOREIGN KEY (id_marca) REFERENCES marca(id_marca),

    CONSTRAINT ux_equipamento_numero_serie UNIQUE (numero_serie)
);

CREATE INDEX ix_equipamento_cliente ON equipamento(id_cliente);
CREATE INDEX ix_equipamento_tipo ON equipamento(id_tipo_equipamento);
CREATE INDEX ix_equipamento_marca ON equipamento(id_marca);

-- 5. STATUS DA ORDEM DE SERVIÇO
CREATE TABLE status_os (
    id_status_os TINYINT IDENTITY(1,1) PRIMARY KEY,
    descricao VARCHAR(30) NOT NULL,

    CONSTRAINT ux_status_os_descricao UNIQUE (descricao)
);

-- 6. TÉCNICO
CREATE TABLE tecnico (
    id_tecnico SMALLINT IDENTITY(1,1) PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    cpf CHAR(11) NOT NULL,
    especialidade VARCHAR(50),
    dt_admissao DATE NOT NULL,
    ativo BIT NOT NULL DEFAULT 1,

    CONSTRAINT ux_tecnico_cpf UNIQUE (cpf)
);

-- 7. ORDEM DE SERVIÇO
CREATE TABLE ordem_servico (
    id_ordem_servico INT IDENTITY(1,1) PRIMARY KEY,
    id_equipamento INT NOT NULL,
    id_tecnico SMALLINT,
    id_status_os TINYINT NOT NULL DEFAULT 1,
    dt_abertura DATETIME NOT NULL DEFAULT GETDATE(),
    dt_conclusao DATETIME,
    defeito_relatado VARCHAR(300) NOT NULL,

    CONSTRAINT fk_os_equipamento
        FOREIGN KEY (id_equipamento)
        REFERENCES equipamento(id_equipamento),

    CONSTRAINT fk_os_tecnico
        FOREIGN KEY (id_tecnico)
        REFERENCES tecnico(id_tecnico),

    CONSTRAINT fk_os_status
        FOREIGN KEY (id_status_os)
        REFERENCES status_os(id_status_os),

    CONSTRAINT ck_os_datas
        CHECK (dt_conclusao IS NULL OR dt_conclusao >= dt_abertura)
);

CREATE INDEX ix_os_equipamento ON ordem_servico(id_equipamento);
CREATE INDEX ix_os_tecnico ON ordem_servico(id_tecnico);
CREATE INDEX ix_os_status ON ordem_servico(id_status_os);

-- 8. SERVIÇO
CREATE TABLE servico (
    id_servico SMALLINT IDENTITY(1,1) PRIMARY KEY,
    descricao VARCHAR(100) NOT NULL,
    valor_base DECIMAL(10,2) NOT NULL,
    tempo_estimado_min SMALLINT,

    CONSTRAINT ux_servico_descricao UNIQUE (descricao),
    CONSTRAINT ck_servico_valor CHECK (valor_base >= 0)
);

-- 9. SERVIÇOS DA ORDEM DE SERVIÇO
CREATE TABLE os_servico (
    id_ordem_servico INT NOT NULL,
    id_servico SMALLINT NOT NULL,
    quantidade TINYINT NOT NULL DEFAULT 1,
    valor_cobrado DECIMAL(10,2) NOT NULL,

    CONSTRAINT pk_os_servico
        PRIMARY KEY (id_ordem_servico, id_servico),

    CONSTRAINT fk_os_servico_os
        FOREIGN KEY (id_ordem_servico)
        REFERENCES ordem_servico(id_ordem_servico),

    CONSTRAINT fk_os_servico_servico
        FOREIGN KEY (id_servico)
        REFERENCES servico(id_servico),

    CONSTRAINT ck_os_servico_quantidade CHECK (quantidade > 0),
    CONSTRAINT ck_os_servico_valor CHECK (valor_cobrado >= 0)
);

CREATE INDEX ix_os_servico_servico ON os_servico(id_servico);

-- 10. FORNECEDOR
CREATE TABLE fornecedor (
    id_fornecedor INT IDENTITY(1,1) PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    cnpj CHAR(14) NOT NULL,
    telefone VARCHAR(15),
    email VARCHAR(150),
    endereco VARCHAR(150),
    estado CHAR(2),
    dt_cadastro DATE NOT NULL DEFAULT CAST(GETDATE() AS DATE),

    CONSTRAINT ux_fornecedor_cnpj UNIQUE (cnpj)
);

-- 11. CATEGORIA DE PEÇA
CREATE TABLE categoria_peca (
    id_categoria_peca TINYINT IDENTITY(1,1) PRIMARY KEY,
    nome VARCHAR(50) NOT NULL,

    CONSTRAINT ux_categoria_peca_nome UNIQUE (nome)
);

-- 12. PEÇA
CREATE TABLE peca (
    id_peca INT IDENTITY(1,1) PRIMARY KEY,
    id_fornecedor INT NOT NULL,
    id_categoria_peca TINYINT NOT NULL,
    nome VARCHAR(100) NOT NULL,
    preco DECIMAL(10,2) NOT NULL,
    estoque_atual INT NOT NULL DEFAULT 0,
    estoque_minimo INT NOT NULL DEFAULT 0,
    dt_cadastro DATE NOT NULL DEFAULT CAST(GETDATE() AS DATE),

    CONSTRAINT fk_peca_fornecedor
        FOREIGN KEY (id_fornecedor)
        REFERENCES fornecedor(id_fornecedor),

    CONSTRAINT fk_peca_categoria
        FOREIGN KEY (id_categoria_peca)
        REFERENCES categoria_peca(id_categoria_peca),

    CONSTRAINT ck_peca_preco CHECK (preco >= 0),
    CONSTRAINT ck_peca_estoque CHECK (estoque_atual >= 0),
    CONSTRAINT ck_peca_estoque_minimo CHECK (estoque_minimo >= 0)
);

CREATE INDEX ix_peca_fornecedor ON peca(id_fornecedor);
CREATE INDEX ix_peca_categoria ON peca(id_categoria_peca);

-- 13. PEÇAS DA ORDEM DE SERVIÇO
CREATE TABLE os_peca (
    id_ordem_servico INT NOT NULL,
    id_peca INT NOT NULL,
    quantidade SMALLINT NOT NULL DEFAULT 1,
    preco_unitario DECIMAL(10,2) NOT NULL,

    CONSTRAINT pk_os_peca
        PRIMARY KEY (id_ordem_servico, id_peca),

    CONSTRAINT fk_os_peca_os
        FOREIGN KEY (id_ordem_servico)
        REFERENCES ordem_servico(id_ordem_servico),

    CONSTRAINT fk_os_peca_peca
        FOREIGN KEY (id_peca)
        REFERENCES peca(id_peca),

    CONSTRAINT ck_os_peca_quantidade CHECK (quantidade > 0),
    CONSTRAINT ck_os_peca_preco CHECK (preco_unitario >= 0)
);

CREATE INDEX ix_os_peca_peca ON os_peca(id_peca);

-- 14. FORMA DE PAGAMENTO
CREATE TABLE forma_pagamento (
    id_forma_pagamento TINYINT IDENTITY(1,1) PRIMARY KEY,
    descricao VARCHAR(30) NOT NULL,

    CONSTRAINT ux_forma_pagamento_descricao UNIQUE (descricao)
);

-- 15. PAGAMENTO
CREATE TABLE pagamento (
    id_pagamento INT IDENTITY(1,1) PRIMARY KEY,
    id_ordem_servico INT NOT NULL,
    id_forma_pagamento TINYINT NOT NULL,
    valor DECIMAL(10,2) NOT NULL,
    dt_pagamento DATETIME NOT NULL DEFAULT GETDATE(),
    status TINYINT NOT NULL DEFAULT 1,

    CONSTRAINT fk_pagamento_os
        FOREIGN KEY (id_ordem_servico)
        REFERENCES ordem_servico(id_ordem_servico),

    CONSTRAINT fk_pagamento_forma
        FOREIGN KEY (id_forma_pagamento)
        REFERENCES forma_pagamento(id_forma_pagamento),

    CONSTRAINT ck_pagamento_valor CHECK (valor > 0),
    CONSTRAINT ck_pagamento_status CHECK (status IN (1, 2, 3))
);

CREATE INDEX ix_pagamento_os ON pagamento(id_ordem_servico);
CREATE INDEX ix_pagamento_forma ON pagamento(id_forma_pagamento);

-- 16. HISTÓRICO DE STATUS DA OS
CREATE TABLE historico_status_os (
    id_historico INT IDENTITY(1,1) PRIMARY KEY,
    id_ordem_servico INT NOT NULL,
    id_status_anterior TINYINT,
    id_status_novo TINYINT NOT NULL,
    dt_alteracao DATETIME NOT NULL DEFAULT GETDATE(),

    CONSTRAINT fk_historico_os
        FOREIGN KEY (id_ordem_servico)
        REFERENCES ordem_servico(id_ordem_servico),

    CONSTRAINT fk_historico_status_anterior
        FOREIGN KEY (id_status_anterior)
        REFERENCES status_os(id_status_os),

    CONSTRAINT fk_historico_status_novo
        FOREIGN KEY (id_status_novo)
        REFERENCES status_os(id_status_os)
);

CREATE INDEX ix_historico_os_data
ON historico_status_os(id_ordem_servico, dt_alteracao);

CREATE INDEX ix_historico_status
ON historico_status_os(id_status_novo);

-- 17. GARANTIA
CREATE TABLE garantia (
    id_garantia INT IDENTITY(1,1) PRIMARY KEY,
    id_ordem_servico INT NOT NULL,
    dt_inicio DATE NOT NULL DEFAULT CAST(GETDATE() AS DATE),
    prazo_dias SMALLINT NOT NULL DEFAULT 90,
    cobertura VARCHAR(200),

    CONSTRAINT fk_garantia_os
        FOREIGN KEY (id_ordem_servico)
        REFERENCES ordem_servico(id_ordem_servico),

    CONSTRAINT ux_garantia_os UNIQUE (id_ordem_servico),

    CONSTRAINT ck_garantia_prazo
        CHECK (prazo_dias BETWEEN 1 AND 365)
);

-- =====================================================
-- FIM DO SCRIPT - 17 TABELAS
-- =====================================================
